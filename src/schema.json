{
  "LOG_GROUP_DEF": {
    "layouts": [["id", "name"]],
    "columns": { "id": { "type": "dec" }, "name": { "type": "ident" } },
    "defines": [{ "kind": "log.group", "id": "id", "name": "name" }],
    "label": "name"
  },
  "LOG_DEF": {
    "layouts": [["code", "name", "text"], ["code", "level", "data", "name", "text"]],
    "columns": {
      "code": { "type": "u16", "range": [1, 65534] },
      "level": { "type": "oneOf", "values": ["DEBUG", "INFO", "WARNING", "ERROR"] },
      "data": { "type": "oneOf", "values": ["NONE", "U32", "I32", "HEX", "U16x2"] },
      "name": { "type": "ident" },
      "text": { "type": "string", "format": true, "maxPlaceholder": 3 }
    },
    "defines": [{ "kind": "log.event", "id": "code", "name": "name" }],
    "parent": { "kind": "log.group", "highByteOf": "code" },
    "label": "name"
  },
  "CONFIG_GROUP_DEF": {
    "layouts": [["id", "name", "label"]],
    "columns": { "id": { "type": "dec" }, "name": { "type": "ident" }, "label": { "type": "string" } },
    "defines": [{ "kind": "config.group", "id": "id", "name": "name" }],
    "label": "name"
  },
  "CONFIG_BOOL": {
    "layouts": [["id", "name", "group", "default", "label"]],
    "columns": { "id": { "type": "u16", "range": [1, 65534] }, "name": { "type": "ident" }, "group": { "type": "dec", "ref": "config.group:id" }, "default": { "type": "number" }, "label": { "type": "string" } },
    "defines": [{ "kind": "config.field", "id": "id", "name": "name" }],
    "parent": { "kind": "config.group", "column": "group", "by": "id" },
    "label": "name"
  },
  "CONFIG_U32": {
    "layouts": [["id", "name", "group", "default", "min", "max", "label"]],
    "columns": { "id": { "type": "u16", "range": [1, 65534] }, "name": { "type": "ident" }, "group": { "type": "dec", "ref": "config.group:id" }, "default": { "type": "number" }, "min": { "type": "number" }, "max": { "type": "number" }, "label": { "type": "string" } },
    "defines": [{ "kind": "config.field", "id": "id", "name": "name" }],
    "parent": { "kind": "config.group", "column": "group", "by": "id" },
    "label": "name"
  },
  "CONFIG_IPV4": {
    "layouts": [["id", "name", "group", "default", "label"]],
    "columns": { "id": { "type": "u16", "range": [1, 65534] }, "name": { "type": "ident" }, "group": { "type": "dec", "ref": "config.group:id" }, "default": { "type": "tuple" }, "label": { "type": "string" } },
    "defines": [{ "kind": "config.field", "id": "id", "name": "name" }],
    "parent": { "kind": "config.group", "column": "group", "by": "id" },
    "label": "name"
  },
  "CONFIG_HOST": {
    "layouts": [["id", "name", "group", "default", "max", "label"]],
    "columns": { "id": { "type": "u16", "range": [1, 65534] }, "name": { "type": "ident" }, "group": { "type": "dec", "ref": "config.group:id" }, "default": { "type": "string" }, "max": { "type": "number" }, "label": { "type": "string" } },
    "defines": [{ "kind": "config.field", "id": "id", "name": "name" }],
    "parent": { "kind": "config.group", "column": "group", "by": "id" },
    "label": "name"
  },
  "CONFIG_TEXT": {
    "layouts": [["id", "name", "group", "default", "max", "label"]],
    "columns": { "id": { "type": "u16", "range": [1, 65534] }, "name": { "type": "ident" }, "group": { "type": "dec", "ref": "config.group:id" }, "default": { "type": "string" }, "max": { "type": "number" }, "label": { "type": "string" } },
    "defines": [{ "kind": "config.field", "id": "id", "name": "name" }],
    "parent": { "kind": "config.group", "column": "group", "by": "id" },
    "label": "name"
  },
  "CONFIG_ENUM": {
    "layouts": [["id", "name", "group", "default", "label"]],
    "columns": { "id": { "type": "u16", "range": [1, 65534] }, "name": { "type": "ident" }, "group": { "type": "dec", "ref": "config.group:id" }, "default": { "type": "ident" }, "label": { "type": "string" } },
    "defines": [
      { "kind": "config.field", "id": "id", "name": "name" },
      { "kind": "config.enum", "name": "name", "unique": false }
    ],
    "parent": { "kind": "config.group", "column": "group", "by": "id" },
    "label": "name"
  },
  "CONFIG_OPTION": {
    "layouts": [["enum", "value", "name", "label"]],
    "columns": { "enum": { "type": "ident", "ref": "config.enum:name" }, "value": { "type": "number" }, "name": { "type": "ident" }, "label": { "type": "string" } },
    "parent": { "kind": "config.enum", "column": "enum", "by": "name" },
    "label": "name"
  },
  "CONFIG_RULE": {
    "layouts": [["id", "name", "label"]],
    "columns": { "id": { "type": "u16", "range": [1, 65534] }, "name": { "type": "ident" }, "label": { "type": "string" } },
    "defines": [{ "kind": "config.rule", "id": "id", "name": "name" }],
    "label": "name"
  },
  "CHANNEL_DEF": {
    "layouts": [["guard", "name", "depth"]],
    "columns": { "guard": { "type": "ident" }, "name": { "type": "ident" }, "depth": { "type": "number" } },
    "defines": [{ "kind": "channel", "name": "name" }],
    "label": "name"
  }
}
