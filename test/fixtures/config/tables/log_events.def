/**********************************************************************************
 * Synthetic test fixture: log catalog of a fictional demo device.
 **********************************************************************************/

/*
 * Columns of LOG_DEF:
 *   code   16 bit, unique, not 0xFFFF. 0x0000 is reserved.
 *   name   Identifier used at the call site
 *   text   C# composite format string. {0} to {3} are the arguments in order,
 *          format specifiers apply, e.g. {0:X4}. Literal braces are doubled.
 */

#define DEMO_CATALOG_VERSION 3

#include "../../lib/config/tables/base_log_events.def"

/* Group id 7 is reserved. */
LOG_GROUP_DEF(6,  SENSOR)
LOG_GROUP_DEF(8,  LINK)

LOG_DEF(0x0601, SENSOR_READ,       "sensor {0}: {1} mV, offset {2} us")
LOG_DEF(0x0602, SENSOR_OFFLINE,    "sensor {0} offline")        // trailing comment
LOG_DEF(0x0603, SENSOR_BRACES,     "literal {{braces}} and {0:X4}, escaped \" quote, (paren")

LOG_DEF(0x0801, LINK_UP,           "link up")
LOG_DEF(0x0802, LINK_ADDRESS,      "address {0}.{1}.{2}.{3}")
LOG_DEF  (0x0803, LINK_ALIGNED,    "space before the parenthesis")
